<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <data>
        <import type="com.topjohnwu.magisk.core.Info" />
        <variable name="viewModel" type="com.topjohnwu.magisk.ui.home.HomeViewModel" />
    </data>
    <androidx.core.widget.NestedScrollView
        style="@style/WidgetFoundation.Metro.Page"
        android:layout_width="match_parent" android:layout_height="match_parent"
        android:background="?colorSurface" android:clipToPadding="false"
        android:fillViewport="true" android:paddingTop="@dimen/internal_action_bar_size"
        android:paddingBottom="16dp" app:fitsSystemWindowsInsets="top|bottom">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:paddingStart="16dp" android:paddingEnd="16dp"
            android:paddingTop="8dp" android:paddingBottom="8dp">

            <LinearLayout android:id="@+id/install_magisk" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:clickable="true" android:focusable="true"
                android:foreground="?attr/selectableItemBackground" android:gravity="center_vertical"
                android:minHeight="64dp" android:orientation="horizontal"
                android:paddingTop="12dp" android:paddingBottom="12dp">
                <ImageView android:layout_width="36dp" android:layout_height="36dp"
                    android:tag="metroAccentTint" android:src="@drawable/ic_download_md2" />
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_marginStart="16dp" android:layout_weight="1" android:orientation="vertical">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:text="@string/metro_install_magisk" android:textColor="?colorOnSurface"
                        android:textSize="16sp" android:textStyle="bold" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:text="@string/metro_install_magisk_summary" android:textColor="?colorOnSurfaceVariant"
                        android:textSize="12sp" />
                </LinearLayout>
                <ImageView android:layout_width="24dp" android:layout_height="24dp"
                    android:src="@drawable/ic_forth_md2" app:tint="?colorOnSurfaceVariant" />
            </LinearLayout>

            <View android:layout_width="match_parent" android:layout_height="1dp"
                android:layout_marginStart="52dp" android:background="?colorOnSurfaceVariant"
                android:alpha="0.12" />

            <LinearLayout android:id="@+id/uninstall_magisk" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:clickable="true" android:focusable="true"
                android:foreground="?attr/selectableItemBackground" android:gravity="center_vertical"
                android:minHeight="64dp" android:orientation="horizontal"
                android:paddingTop="12dp" android:paddingBottom="12dp">
                <ImageView android:layout_width="36dp" android:layout_height="36dp"
                    android:tag="metroAccentTint" android:src="@drawable/ic_delete_md2" />
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_marginStart="16dp" android:layout_weight="1" android:orientation="vertical">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:text="@string/metro_uninstall_magisk" android:textColor="?colorOnSurface"
                        android:textSize="16sp" android:textStyle="bold" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:text="@string/metro_uninstall_magisk_summary" android:textColor="?colorOnSurfaceVariant"
                        android:textSize="12sp" />
                </LinearLayout>
                <ImageView android:layout_width="24dp" android:layout_height="24dp"
                    android:src="@drawable/ic_forth_md2" app:tint="?colorOnSurfaceVariant" />
            </LinearLayout>

            <View android:layout_width="match_parent" android:layout_height="1dp"
                android:layout_marginStart="52dp" android:background="?colorOnSurfaceVariant"
                android:alpha="0.12" />

            <LinearLayout android:id="@+id/update_manager" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:clickable="true" android:focusable="true"
                android:foreground="?attr/selectableItemBackground" android:gravity="center_vertical"
                android:minHeight="64dp" android:orientation="horizontal"
                android:paddingTop="12dp" android:paddingBottom="12dp">
                <ImageView android:layout_width="36dp" android:layout_height="36dp"
                    android:tag="metroAccentTint" android:src="@drawable/ic_update_md2" />
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_marginStart="16dp" android:layout_weight="1" android:orientation="vertical">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:text="@string/metro_update_manager" android:textColor="?colorOnSurface"
                        android:textSize="16sp" android:textStyle="bold" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:text="@string/metro_update_manager_summary" android:textColor="?colorOnSurfaceVariant"
                        android:textSize="12sp" />
                </LinearLayout>
                <ImageView android:layout_width="24dp" android:layout_height="24dp"
                    android:src="@drawable/ic_forth_md2" app:tint="?colorOnSurfaceVariant" />
            </LinearLayout>

            <!-- Flat Metro info block: the fill and the text colors are resolved at runtime by
                 MetroColors so custom / dynamic themes stay readable. -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="8dp" android:tag="metroAccentBg"
                android:orientation="vertical" android:padding="20dp">

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:baselineAligned="false"
                    android:orientation="horizontal">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:tag="metroOnAccentFg"
                        android:text="@string/metro_info_root" android:textSize="16sp" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:tag="metroOnAccentFg"
                        android:text="@{viewModel.rooted ? @string/metro_yes : @string/metro_no}"
                        android:textSize="16sp" android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="8dp" android:baselineAligned="false"
                    android:orientation="horizontal">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:tag="metroOnAccentFg"
                        android:text="@string/metro_info_zygisk" android:textSize="16sp" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:tag="metroOnAccentFg"
                        android:text="@{viewModel.zygiskEnabled ? @string/metro_enabled : @string/metro_disabled}"
                        android:textSize="16sp" android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="8dp" android:baselineAligned="false"
                    android:orientation="horizontal">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:tag="metroOnAccentFg"
                        android:text="@string/metro_info_ramdisk" android:textSize="16sp" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:tag="metroOnAccentFg"
                        android:text="@{viewModel.ramdisk ? @string/metro_yes : @string/metro_no}"
                        android:textSize="16sp" android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</layout>
