<?xml version="1.0" encoding="utf-8"?>
<!-- Windows 10 style flat rectangular switch track -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Disabled state -->
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <size android:width="44dp" android:height="20dp" />
            <solid android:color="#00000000" />
            <stroke android:width="2dp" android:color="#FFBDBDBD" />
            <corners android:radius="2dp" />
        </shape>
    </item>
    <!-- Checked (on) state: solid fill (tinted by trackTint) -->
    <item android:state_checked="true">
        <shape android:shape="rectangle">
            <size android:width="44dp" android:height="20dp" />
            <solid android:color="#FFFFFFFF" />
            <corners android:radius="2dp" />
        </shape>
    </item>
    <!-- Default (off) state: transparent with border -->
    <item>
        <shape android:shape="rectangle">
            <size android:width="44dp" android:height="20dp" />
            <solid android:color="#00000000" />
            <stroke android:width="2dp" android:color="#FF757575" />
            <corners android:radius="2dp" />
        </shape>
    </item>
</selector>
